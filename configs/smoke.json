{
  "schema_version": "0.1",
  "name": "smoke",
  "env": {
    "problems": 20,
    "approaches_min": 1,
    "approaches_max": 3,
    "chain_min": 1,
    "chain_max": 3,
    "shared_lemma_prob": 0.5,
    "dead_fraction": 0.2,
    "p_alpha": 0.4,
    "p_beta": 0.6,
    "cost_log_mean": 0.0,
    "cost_log_sd": 0.5,
    "attempt_cost_sd": 0.3,
    "failure_cost_mult": 1.5,
    "hint_noise": 1.0
  },
  "run": {
    "seed": 1,
    "workers": 8,
    "budget_units": 400.0,
    "attempt_cap_units": 8.0,
    "verify_cost_units": 0.25,
    "crash_prob": 0.02,
    "max_attempts_per_task": 50,
    "max_parallel_per_task": 2,
    "prior_cost": 1.0,
    "policy": { "kind": "thompson", "prior_strength": 2.0, "use_hints": true }
  }
}
